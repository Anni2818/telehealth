# Copy to .env in this directory and replace placeholders locally.
# Never commit .env or paste secrets into chat.

# Application / authentication
JWT_SECRET_KEY=REPLACE_WITH_python_secrets_token_hex_32_OUTPUT
AZURE_SQL_CONNECTIONSTRING=

# Existing Azure AI Foundry receptionist agent (separate from Azure OpenAI screening)
FOUNDRY_TENANT_ID=
FOUNDRY_CLIENT_ID=
FOUNDRY_CLIENT_SECRET=
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=

# Optional semantic emergency screening. Disabled by default.
SEMANTIC_EMERGENCY_SCREENING_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMERGENCY_DEPLOYMENT=
SEMANTIC_SCREENING_TIMEOUT_SECONDS=12

# Only required when running app.mcp_server.gateway as a separate MCP service.
MCP_API_KEY=
MCP_PUBLIC_HOST=localhost
# Optional URL override for the MCP client test script.
MCP_TEST_URL=http://127.0.0.1:8001/mcp
